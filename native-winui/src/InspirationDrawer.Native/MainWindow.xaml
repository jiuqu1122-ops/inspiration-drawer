<Window
    x:Class="InspirationDrawer.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:InspirationDrawer.Native.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="灵感抽屉 Native">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>

        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="56"
            OpenPaneLength="220"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="全部" Icon="AllApps" IsSelected="True" Tag="all" />
                <NavigationViewItem Content="图片" Icon="Pictures" Tag="image" />
                <NavigationViewItem Content="文本" Icon="Document" Tag="text" />
                <NavigationViewItem Content="文件" Icon="OpenFile" Tag="file" />
                <NavigationViewItem Content="视频" Icon="Video" Tag="video" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="无限画布" Icon="Map" Tag="canvas" />
                <NavigationViewItem Content="AI 生图" Icon="Camera" Tag="ai" />
                <NavigationViewItem Content="桌面便签" Icon="Edit" Tag="notes" />
            </NavigationView.MenuItems>

            <Grid Padding="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="灵感抽屉" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" Text="正在读取旧版抽屉数据..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        QueryIcon="Find"
                        PlaceholderText="搜索名称、内容、路径"
                        TextChanged="SearchBox_TextChanged" />

                    <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent">
                        <AppBarButton x:Name="RefreshButton" Click="RefreshButton_Click" Icon="Refresh" Label="刷新" />
                        <AppBarButton Icon="Add" Label="添加" IsEnabled="False" />
                        <AppBarButton Icon="Camera" Label="截图" IsEnabled="False" />
                    </CommandBar>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="分类" FontSize="16" FontWeight="SemiBold" />
                            <ListView
                                x:Name="FolderList"
                                Grid.Row="1"
                                SelectionChanged="FolderList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="44" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <InfoBadge Grid.Column="2" Value="{Binding Count}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ContentTitle" Text="全部素材" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ContentSubtitle" Text="只读预览旧版 Tauri 数据，下一步会迁移拖拽、画布和 AI 生图。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="进入画布" Click="CanvasButton_Click" />
                            </Grid>

                            <ScrollViewer Grid.Row="1">
                                <ItemsRepeater x:Name="ItemRepeater">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="230" MinColumnSpacing="12" MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinHeight="252"
                                                Padding="12"
                                                CornerRadius="8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                DoubleTapped="Card_DoubleTapped">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="132" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        CornerRadius="6"
                                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                        <Grid>
                                                            <Image
                                                                Source="{Binding Image}"
                                                                Stretch="UniformToFill"
                                                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <StackPanel
                                                                Spacing="8"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="30" />
                                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Text="{Binding Description}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="2"
                                                        TextWrapping="Wrap" />
                                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FolderName}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedLabel}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Grid>
                                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                                                        <Button Content="打开" Click="OpenCard_Click" IsEnabled="{Binding CanOpen}" />
                                                        <Button Content="定位" Click="RevealCard_Click" IsEnabled="{Binding CanReveal}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
