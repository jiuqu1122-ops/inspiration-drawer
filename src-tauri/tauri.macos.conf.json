        "minWidth": 48,
        "minHeight": 48,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "note_2",
        "url": "note.html",
        "title": "Desktop Note",
        "width": 360,
        "height": 320,
        "minWidth": 48,
        "minHeight": 48,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
