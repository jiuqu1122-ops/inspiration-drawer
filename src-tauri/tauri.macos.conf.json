{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "art.unmind.inspirationdrawer",
  "app": {
    "windows": [
      {
        "label": "edge",
        "title": "Inspiration Drawer - Edge Trigger",
        "width": 20,
        "height": 800,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "main",
        "title": "Inspiration Drawer",
        "width": 960,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "snip",
        "title": "Screenshot Selection",
        "width": 800,
        "height": 600,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "note_1",
