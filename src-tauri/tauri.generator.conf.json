{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inspiration Drawer License Generator",
  "version": "4.3.6",
  "identifier": "com.inspirationdrawer.licensegenerator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/license-generator.html",
    "beforeBuildCommand": "npm run license-generator:frontend",
    "frontendDist": "../dist-generator"
  },
  "app": {
    "windows": [
      {
        "label": "license_generator",
        "url": "license-generator.html",
        "title": "授权生成器",
        "width": 960,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Inspiration Drawer"
      }
    }
  }
}
