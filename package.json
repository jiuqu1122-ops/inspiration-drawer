{
  "name": "inspiration-drawer",
  "private": true,
  "version": "4.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "license-generator:frontend": "tsc && vite build --config vite.generator.config.ts",
    "license-generator:dev": "tauri dev --config src-tauri/tauri.generator.conf.json --features license-generator-app -- --bin license-generator-app",
    "license-generator:build": "node scripts/build-license-generator.mjs",
    "license-generator:bundle": "tauri build --config src-tauri/tauri.generator.conf.json --features license-generator-app -- --bin license-generator-app",
    "license-generator:open": "npm run license-generator:build && start \"\" \"src-tauri\\target\\generator\\license-generator-app.exe\"",
    "updater:release": "node scripts/build-github-release.mjs",
    "updater:prepare": "node scripts/prepare-github-release.mjs",
    "updater:sync:gitee": "node scripts/sync-gitee-release.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.0.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
